<mxfile host="app.diagrams.net" modified="2026-10-29T12:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="mindcare-architecture" name="MindCare Architecture">
    <mxGraphModel dx="1920" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="MindCare — System Architecture&#xa;Current implementation · React + Express + FastAPI + MongoDB" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=25;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="55" as="geometry"/></mxCell>

        <mxCell id="L1" value="1  PRESENTATION LAYER · React 19 + Vite" style="swimlane;html=1;startSize=32;rounded=1;fillColor=#F4F7FB;swimlaneFillColor=#FFFFFF;strokeColor=#42648E;fontColor=#172B4D;fontStyle=1;fontSize=17;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1440" height="220" as="geometry"/></mxCell>
        <mxCell id="p_reflection" value="&lt;b&gt;Reflection workspace&lt;/b&gt;&lt;br&gt;• Typed reflection and voice recording&lt;br&gt;• Transcript review before confirmation&lt;br&gt;• Separate emotion and sentiment results&lt;br&gt;• History and insight views" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C83A0;fontColor=#172B4D;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="L1"><mxGeometry x="20" y="48" width="440" height="150" as="geometry"/></mxCell>
        <mxCell id="p_wellbeing" value="&lt;b&gt;Wellbeing pages&lt;/b&gt;&lt;br&gt;• Home and manual mood check-in&lt;br&gt;• Fun Zone activities and progress&lt;br&gt;• Profile and quick support&lt;br&gt;• Login, registration and navigation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C83A0;fontColor=#172B4D;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="L1"><mxGeometry x="490" y="48" width="440" height="150" as="geometry"/></mxCell>
        <mxCell id="p_browser" value="&lt;b&gt;Browser integration&lt;/b&gt;&lt;br&gt;• React Router and reusable components&lt;br&gt;• API service modules and authenticated calls&lt;br&gt;• Audio capture, local state and storage hooks&lt;br&gt;• JSON requests and multipart audio uploads" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C83A0;fontColor=#172B4D;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="L1"><mxGeometry x="960" y="48" width="450" height="150" as="geometry"/></mxCell>

        <mxCell id="L2" value="2  APPLICATION API &amp; AUTHENTICATION · Node.js + Express" style="swimlane;html=1;startSize=32;rounded=1;fillColor=#F4F7FB;swimlaneFillColor=#FFFFFF;strokeColor=#42648E;fontColor=#172B4D;fontStyle=1;fontSize=17;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="365" width="1440" height="205" as="geometry"/></mxCell>
        <mxCell id="api_gateway" value="&lt;b&gt;Express request handling&lt;/b&gt;&lt;br&gt;• CORS and JSON parsing&lt;br&gt;• Input validation and response handling&lt;br&gt;• Forwards text and audio to ML service&lt;br&gt;• Removes temporary audio upload after forwarding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C83A0;fontColor=#172B4D;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="L2"><mxGeometry x="25" y="48" width="610" height="140" as="geometry"/></mxCell>
        <mxCell id="api_routes" value="&lt;b&gt;REST API routes&lt;/b&gt;&lt;br&gt;/auth · /users · /moods · /reflections&lt;br&gt;/activities · /insights · /safety&lt;br&gt;Protected reflection save, confirmation and history&lt;br&gt;Mood, activity, profile, insight and safety operations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C83A0;fontColor=#172B4D;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="L2"><mxGeometry x="665" y="48" width="745" height="140" as="geometry"/></mxCell>

        <mxCell id="L3" value="3  ANALYSIS SERVICE · Python + FastAPI" style="swimlane;html=1;startSize=32;rounded=1;fillColor=#F4F7FB;swimlaneFillColor=#FFFFFF;strokeColor=#42648E;fontColor=#172B4D;fontStyle=1;fontSize=17;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="635" width="850" height="245" as="geometry"/></mxCell>
        <mxCell id="ml_service" value="&lt;b&gt;Implemented inference endpoints&lt;/b&gt;&lt;br&gt;POST /analyze-text · POST /transcribe&lt;br&gt;POST /analyze-voice · POST /analyze-sentiment&lt;br&gt;GET /health&lt;br&gt;&lt;br&gt;&lt;b&gt;Text models&lt;/b&gt;&lt;br&gt;DistilRoBERTa emotion · DistilBERT sentiment&lt;br&gt;English validation · separate labels and confidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C83A0;fontColor=#172B4D;fontSize=14;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="L3"><mxGeometry x="20" y="48" width="395" height="180" as="geometry"/></mxCell>
        <mxCell id="ml_audio" value="&lt;b&gt;Speech and audio processing&lt;/b&gt;&lt;br&gt;• Whisper English speech recognition&lt;br&gt;• Audio decoding and 16 kHz resampling&lt;br&gt;• Pitch, energy and pause features&lt;br&gt;• Voice analysis status and feature response&lt;br&gt;• Model/service errors returned when unavailable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C83A0;fontColor=#172B4D;fontSize=14;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="L3"><mxGeometry x="435" y="48" width="395" height="180" as="geometry"/></mxCell>

        <mxCell id="L4" value="4  DATA PERSISTENCE · MongoDB + Mongoose" style="swimlane;html=1;startSize=32;rounded=1;fillColor=#F1F8F4;swimlaneFillColor=#FFFFFF;strokeColor=#5B927D;fontColor=#172B4D;fontStyle=1;fontSize=17;collapsible=0;" vertex="1" parent="1"><mxGeometry x="930" y="635" width="550" height="245" as="geometry"/></mxCell>
        <mxCell id="database" value="&lt;b&gt;Application records defined by current models&lt;/b&gt;&lt;br&gt;Users · Reflections · AnalysisResults · MoodEntries&lt;br&gt;Activities · UserActivities · ActivitySessions&lt;br&gt;Insights · Recommendations · Preferences · Badges&lt;br&gt;SafetyFlags · EmergencyContacts · PersonalBaselines&lt;br&gt;&lt;br&gt;Records are read and written by Express through Mongoose." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B927D;fontColor=#172B4D;fontSize=14;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="L4"><mxGeometry x="20" y="48" width="510" height="180" as="geometry"/></mxCell>

        <mxCell id="cross" value="CROSS-CUTTING SECURITY &amp; CONFIGURATION" style="swimlane;html=1;startSize=44;rounded=1;fillColor=#F8FAFC;swimlaneFillColor=#FFFFFF;strokeColor=#526D8C;fontColor=#172B4D;fontStyle=1;fontSize=15;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1520" y="90" width="360" height="790" as="geometry"/></mxCell>
        <mxCell id="cross_auth" value="&lt;b&gt;Authentication&lt;/b&gt;&lt;br&gt;• Passwords hashed with bcryptjs&lt;br&gt;• Signed tokens identify users&lt;br&gt;• Protected reflection routes scope records to the signed-in user" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#91A3B8;fontColor=#172B4D;fontSize=14;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="cross"><mxGeometry x="18" y="58" width="324" height="155" as="geometry"/></mxCell>
        <mxCell id="cross_service" value="&lt;b&gt;Service boundary&lt;/b&gt;&lt;br&gt;• Optional X-API-Key between Express and FastAPI&lt;br&gt;• Health endpoints report component state&lt;br&gt;• Errors are returned when analysis is unavailable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#91A3B8;fontColor=#172B4D;fontSize=14;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="cross"><mxGeometry x="18" y="235" width="324" height="160" as="geometry"/></mxCell>
        <mxCell id="cross_config" value="&lt;b&gt;Deployment configuration&lt;/b&gt;&lt;br&gt;MONGO_URI — database connection&lt;br&gt;ML_SERVICE_URL — inference service&lt;br&gt;AUTH_TOKEN_SECRET — signed tokens&lt;br&gt;PORT — Express API port" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#91A3B8;fontColor=#172B4D;fontSize=14;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="cross"><mxGeometry x="18" y="418" width="324" height="145" as="geometry"/></mxCell>
        <mxCell id="cross_note" value="&lt;b&gt;Model transparency&lt;/b&gt;&lt;br&gt;English-focused models. Results are estimates and are not clinical diagnoses.&lt;br&gt;&lt;br&gt;Only implemented components and flows are shown." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5E8;strokeColor=#C38A42;fontColor=#172B4D;fontSize=14;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="cross"><mxGeometry x="18" y="586" width="324" height="150" as="geometry"/></mxCell>

        <!-- Explicit request and response directions between layers -->
        <mxCell id="e_ui_request" value="HTTP request ↓" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#315D8A;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#315D8A;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p_browser" target="api_routes"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_api_response" value="API response ↑" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#315D8A;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#315D8A;labelBackgroundColor=#FFFFFF;exitX=0.58;exitY=0;entryX=0.58;entryY=1;" edge="1" parent="1" source="api_routes" target="p_browser"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_ml_request" value="Text / audio request ↓" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#315D8A;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#315D8A;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="api_gateway" target="ml_service"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_ml_response" value="Transcript / analysis result ↑" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#315D8A;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#315D8A;labelBackgroundColor=#FFFFFF;exitX=0.72;exitY=0;entryX=0.72;entryY=1;" edge="1" parent="1" source="ml_service" target="api_gateway"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_db_write" value="Mongoose write ↓" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#477B69;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#315D8A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="api_routes" target="database"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1475" y="483"/><mxPoint x="1475" y="773"/></Array></mxGeometry></mxCell>
        <mxCell id="e_db_read" value="Query result ↑" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#477B69;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#315D8A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.67;entryX=1;entryY=0.73;" edge="1" parent="1" source="database" target="api_routes"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1490" y="803"/><mxPoint x="1490" y="515"/></Array></mxGeometry></mxCell>

        <!-- Voice reflection sequence -->
        <mxCell id="voice_title" value="VOICE REFLECTION · two-step review and confirmation flow" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="42" y="910" width="1200" height="34" as="geometry"/></mxCell>
        <mxCell id="voice_band" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F8FC;strokeColor=#42648E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="950" width="1840" height="250" as="geometry"/></mxCell>
        <mxCell id="v1" value="&lt;b&gt;1 · Record&lt;/b&gt;&lt;br&gt;Browser captures reflection audio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C83A0;fontColor=#172B4D;fontSize=14;" vertex="1" parent="1"><mxGeometry x="62" y="1010" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="v2" value="&lt;b&gt;2 · Upload&lt;/b&gt;&lt;br&gt;POST /api/reflections/transcribe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C83A0;fontColor=#172B4D;fontSize=14;" vertex="1" parent="1"><mxGeometry x="322" y="1010" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="v3" value="&lt;b&gt;3 · Transcribe&lt;/b&gt;&lt;br&gt;FastAPI + Whisper; extract audio features" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C83A0;fontColor=#172B4D;fontSize=14;" vertex="1" parent="1"><mxGeometry x="582" y="1010" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="v4" value="&lt;b&gt;4 · Review&lt;/b&gt;&lt;br&gt;Transcript returned for user review and edits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5E8;strokeColor=#C38A42;fontColor=#172B4D;fontSize=14;" vertex="1" parent="1"><mxGeometry x="842" y="1010" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="v5" value="&lt;b&gt;5 · Confirm + analyze&lt;/b&gt;&lt;br&gt;Signed request; text analysis runs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C83A0;fontColor=#172B4D;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1102" y="1010" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="v6" value="&lt;b&gt;6 · Save&lt;/b&gt;&lt;br&gt;Reflection + analysis saved in MongoDB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF7F3;strokeColor=#5B927D;fontColor=#172B4D;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1362" y="1010" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="v7" value="&lt;b&gt;7 · Display&lt;/b&gt;&lt;br&gt;Results returned; history loads through API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C83A0;fontColor=#172B4D;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1622" y="1010" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="e_v1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#315D8A;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="v1" target="v2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_v2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#315D8A;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="v2" target="v3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_v3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#315D8A;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="v3" target="v4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_v4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#315D8A;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="v4" target="v5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_v5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#315D8A;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="v5" target="v6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_v6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#315D8A;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="v6" target="v7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="foot" value="Typed reflections use the same text analysis path without audio transcription. Model outputs are estimates, not clinical diagnoses." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#52627A;" vertex="1" parent="1"><mxGeometry x="42" y="1220" width="1800" height="36" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
