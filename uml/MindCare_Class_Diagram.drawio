        <!-- Major persisted domain classes. -->
        <mxCell id="class-user" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;User&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;- _id: ObjectId&lt;br&gt;- firstName: String&lt;br&gt;- lastName: String&lt;br&gt;- email: String&lt;br&gt;- passwordHash: String&lt;br&gt;- privacyPreferences: Object&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=7;fontSize=13;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="450" y="80" width="340" height="205" as="geometry" /></mxCell>
        <mxCell id="class-mood" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;MoodEntry&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;- _id: ObjectId&lt;br&gt;- mood: String&lt;br&gt;- note: String&lt;br&gt;- createdAt: Date&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=7;fontSize=13;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="900" y="80" width="320" height="165" as="geometry" /></mxCell>
        <mxCell id="class-badge" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;UserBadge&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;- _id: ObjectId&lt;br&gt;- userId: ObjectId&lt;br&gt;- badgeId: String&lt;br&gt;- unlockedAt: Date&lt;br&gt;+ unique(userId, badgeId)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=7;fontSize=13;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1460" y="80" width="340" height="175" as="geometry" /></mxCell>
        <mxCell id="class-reflection" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Reflection&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;- _id: ObjectId&lt;br&gt;- userId: ObjectId&lt;br&gt;- type: text | voice&lt;br&gt;- content: String&lt;br&gt;- transcript: String&lt;br&gt;- createdAt: Date&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=7;fontSize=13;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="450" y="370" width="360" height="205" as="geometry" /></mxCell>
