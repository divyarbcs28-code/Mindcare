        <mxCell id="class-insight" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Insight&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;- _id: ObjectId&lt;br&gt;- userId: ObjectId&lt;br&gt;- reflectionId: ObjectId&lt;br&gt;- combinedLabel: String&lt;br&gt;- trendStatus: TrendStatus&lt;br&gt;- createdAt: Date&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=7;fontSize=13;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1460" y="370" width="340" height="205" as="geometry" /></mxCell>
        <mxCell id="class-recommendation" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Recommendation&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;- _id: ObjectId&lt;br&gt;- userId: ObjectId&lt;br&gt;- insightId: ObjectId?&lt;br&gt;- recommendation: String&lt;br&gt;- reasonText: String&lt;br&gt;- createdAt: Date&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=7;fontSize=13;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1460" y="650" width="340" height="205" as="geometry" /></mxCell>
        <mxCell id="class-activity" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Activity&lt;/b&gt;&lt;br&gt;&lt;i&gt;(catalog definition)&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;- id: String&lt;br&gt;- title: String&lt;br&gt;- description: String&lt;br&gt;- type: String&lt;br&gt;- durationMinutes: Number&lt;br&gt;- moods: String[]&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=7;fontSize=13;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="450" y="760" width="360" height="205" as="geometry" /></mxCell>
        <mxCell id="class-useractivity" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;UserActivity&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;- _id: ObjectId&lt;br&gt;- userId: ObjectId&lt;br&gt;- activityId: String&lt;br&gt;- mood: String&lt;br&gt;- status: ActivityStatus&lt;br&gt;- recommendedAt: Date&lt;br&gt;- startedAt: Date?&lt;br&gt;- completedAt: Date?&lt;br&gt;- durationMinutes: Number&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=7;fontSize=13;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="900" y="760" width="410" height="230" as="geometry" /></mxCell>

        <mxCell id="note-mood" value="MoodEntry has no userId field in the supplied schema, so no User association is drawn." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=18;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="270" width="320" height="65" as="geometry" /></mxCell>
