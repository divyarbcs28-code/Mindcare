        <!-- Route/controller classes: operations name the major API actions. -->
        <mxCell id="ctrl-auth" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;AuthRoutes&lt;/b&gt;&lt;br&gt;&amp;lt;&amp;lt;controller&amp;gt;&amp;gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;+ registerUser()&lt;br&gt;+ loginUser()&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=7;fontSize=13;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="300" height="125" as="geometry" /></mxCell>
        <mxCell id="ctrl-mood" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;MoodRoutes&lt;/b&gt;&lt;br&gt;&amp;lt;&amp;lt;controller&amp;gt;&amp;gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;+ getMoodEntries()&lt;br&gt;+ createMoodEntry()&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=7;fontSize=13;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="300" height="125" as="geometry" /></mxCell>
        <mxCell id="ctrl-reflection" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;ReflectionRoutes&lt;/b&gt;&lt;br&gt;&amp;lt;&amp;lt;controller&amp;gt;&amp;gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;+ analyzeText()&lt;br&gt;+ transcribeVoice()&lt;br&gt;+ confirmVoice()&lt;br&gt;+ getReflections()&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=7;fontSize=13;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="300" height="160" as="geometry" /></mxCell>
        <mxCell id="ctrl-insight" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;InsightRoutes&lt;/b&gt;&lt;br&gt;&amp;lt;&amp;lt;controller&amp;gt;&amp;gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;+ getInsights()&lt;br&gt;+ createInsight()&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=7;fontSize=13;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="300" height="125" as="geometry" /></mxCell>
